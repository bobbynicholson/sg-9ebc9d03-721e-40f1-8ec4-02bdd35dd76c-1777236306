{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/process-email-notifications",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/process-email-queue",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/late-event-check",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/missed-clock-in-check",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/driver-missed-clock-in-check",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/cleaning-missed-clock-in-check",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/currency-check",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/process-pending-reviews",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/reconcile-payfast",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/equipment-service-due",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/check-en-route",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/auto-complete-delivered",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/update-overdue-invoices",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/archive-old-gps-logs",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/archive-old-notifications",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/archive-old-email-rows",
      "schedule": "30 3 * * 0"
    }
  ]
}
