{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/process-email-notifications",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/process-email-queue",
      "schedule": "*/15 * * * *"
    }
  ]
}
